# Copy this file to .env.local (or .env) and fill in real values.
# See AGENTS.md and architecture-roadmap/ for what each service is used for.

# --- Convex (database, functions & auth) ---
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Email (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Email (SMTP/Nodemailer) — used as primary sender, Resend as fallback ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=Sistema <your-email@gmail.com>

# --- Azure Blob Storage (media uploads) ---
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_STORAGE_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER=media
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account_name;AccountKey=your_storage_account_key;EndpointSuffix=core.windows.net
NEXT_PUBLIC_AZURE_BLOB_BASE=https://your_storage_account_name.blob.core.windows.net/media

# --- Clerk (unused — see architecture-roadmap/ROADMAP.md item 3) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
