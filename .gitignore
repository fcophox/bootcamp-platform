# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Artefactos generados por la migración a Azure (salidas de ejecución)
scripts/media-manifest.json
scripts/rewrite-urls.sql
scripts/url-rewrite-backup.json
.mcp.json
.agentsroom/handoff-transcript-*.txt
.agentsroom/handoff-summary-*.md
.agents/mcp_config.json

# Per-developer AI agent tooling. `npx convex dev` installs these; they are
# machine-local settings and a lockfile for agent skills, not product code.
# .agents/mcp_config.json is already ignored above.
.claude/settings.local.json
.claude/skills/
.agents/skills/
skills-lock.json
